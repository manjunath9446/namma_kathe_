<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="80dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_illustration_bg"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ImageView
                android:id="@+id/ivIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="24dp"
                android:contentDescription="Illustration"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvDistrict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_district_tag"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="@color/primary_saffron"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/tvStory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_brown"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.7"
            android:layout_marginBottom="20dp"/>

        <!-- Badge earned indicator -->
        <TextView
            android:id="@+id/tvBadgeEarned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_earned_strip"
            android:padding="12dp"
            android:gravity="center"
            android:textColor="#1B5E20"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Quiz button -->
        <Button
            android:id="@+id/btnTakeQuiz"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📝 Take Quiz"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary_saffron"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

    </LinearLayout>
</ScrollView>